# Пример конфигурации. Скопируйте в .env и укажите ключ: cp .env.example .env
# Никогда не коммитьте .env с настоящим ключом.

# Провайдер: gemini (по умолчанию) или openai (любой OpenAI-совместимый API, включая Ollama)
LLM_PROVIDER=gemini

# Google Gemini API, бесплатный ключ: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Модель или цепочка через запятую: при перегрузке (503, 429, таймаут) агент переходит к следующей.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite

# OpenAI-совместимый API (LLM_PROVIDER=openai):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=<имя модели>

# Локальная модель через Ollama (LLM_PROVIDER=openai):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=<имя модели из ollama list>
